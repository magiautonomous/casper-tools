{
  "name": "casper-tools",
  "version": "1.1.0",
  "description": "Casper Tools MCP server - 12 agent utilities over Model Context Protocol (Streamable HTTP): JSON inspect, regex test, cron parse, hash, base64, URL analyze, color convert, text diff, CSV parse, JWT decode/verify, Markdown-to-HTML, UUID/token minting",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js"
  },
  "bin": {
    "casper-tools": "server.js"
  },
  "files": [
    "server.js",
    "tools.js",
    "x402-gate.js",
    "server.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "agents",
    "json",
    "regex",
    "cron",
    "hash",
    "base64",
    "url",
    "color",
    "diff",
    "csv",
    "jwt",
    "markdown",
    "uuid",
    "developer-tools",
    "utility",
    "streamable-http"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@x402/evm": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/mcp": "^2.25.0",
    "express": "^5.2.1"
  }
}